<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<SanitizeUserPrompt async="false" continueOnError="false" enabled="true" name="SUP-userprompt">
    <DisplayName>Sanitize User Prompt</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <ModelArmor>
        <!-- guardrail-proxy-in-{strict|balanced|permissive}; ma.template_in is set by JS-MA-Resolve-Profile
             from an allow-list, so callers can only pick a preset, never an arbitrary template. -->
        <TemplateName>projects/{organization.name}/locations/us/templates/{ma.template_in}</TemplateName>
    </ModelArmor>
    <!-- All text parts of all turns (JS-Request-Validate), so earlier-turn injections are inspected too. -->
    <UserPromptSource>{guardrail.inspect_text}</UserPromptSource>
</SanitizeUserPrompt>
