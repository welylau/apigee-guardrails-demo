<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<MessageLogging continueOnError="true" enabled="true" name="ML-Log-ModelArmor-Inbound">
    <DisplayName>Log ModelArmor Inbound Block</DisplayName>
    <CloudLogging>
        <LogName>projects/{organization.name}/logs/apigee-ai-sanitized-prompts</LogName>
        <Message contentType="application/json">{
  "proxy": "{apiproxy.name}",
  "direction": "inbound",
  "maProfile": "{ma.profile_in}",
  "maTemplate": "{ma.template_in}",
  "organization": "{organization.name}",
  "environment": "{environment.name}",
  "developerApp": "{developer.app.name}",
  "developerEmail": "{developer.email}",
  "faultName": "{fault.name}",
  "faultString": "{fault.faultstring}",
  "clientIp": "{client.ip}",
  "timestamp": "{system.timestamp}"
}</Message>
        <Labels>
            <Label>
                <Key>proxy</Key>
                <Value>{apiproxy.name}</Value>
            </Label>
            <Label>
                <Key>direction</Key>
                <Value>inbound</Value>
            </Label>
            <Label>
                <Key>developer_app</Key>
                <Value>{developer.app.name}</Value>
            </Label>
        </Labels>
        <ResourceType>api</ResourceType>
    </CloudLogging>
</MessageLogging>
