<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<SanitizeModelResponse async="false" continueOnError="false" enabled="true" name="SMR-modelresponse">
    <DisplayName>SMR-modelresponse</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <ModelArmor>
        <!-- guardrail-proxy-out-{strict|balanced|permissive}; set in the request flow by JS-MA-Resolve-Profile
             and read here in the streaming EventFlow. -->
        <TemplateName>projects/{organization.name}/locations/us/templates/{ma.template_out}</TemplateName>
    </ModelArmor>
    <LLMResponseSource>{response_partial}</LLMResponseSource>
</SanitizeModelResponse>
