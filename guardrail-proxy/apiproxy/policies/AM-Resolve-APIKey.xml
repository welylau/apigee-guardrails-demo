<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage continueOnError="false" enabled="true" name="AM-Resolve-APIKey">
    <DisplayName>Resolve API Key</DisplayName>
    <AssignVariable>
        <Name>client_apikey</Name>
        <Ref>request.header.x-apikey</Ref>
        <Value></Value>
    </AssignVariable>
    <AssignVariable>
        <Name>client_apikey</Name>
        <Ref>request.header.apikey</Ref>
    </AssignVariable>
    <!-- No query-parameter fallback: keys in URLs end up in access logs and browser history
         (OWASP API2). Requests with ?apikey= / ?key= are rejected by RF-APIKey-In-URL. -->
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
