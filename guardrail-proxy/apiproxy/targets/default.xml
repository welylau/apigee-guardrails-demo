<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
    <PreFlow name="PreFlow">
        <Request>
            <Step>
                <Name>AM-Prepare-Gemini-Request</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <Flows/>
    <EventFlow name="EventFlow" content-type="text/event-stream">
        <Response>
            <Step>
                <Name>JS-combine-resp</Name>
            </Step>
            <Step>
                <Condition>buff_ready = "true" and sg.enabled = "true" and sg.out_mode != "disable"</Condition>
                <Name>JS-SG-Outbound-Scan</Name>
            </Step>
            <Step>
                <Condition>sg.out_action = "block"</Condition>
                <Name>RF-SG-Outbound-Blocked</Name>
            </Step>
            <Step>
                <Condition>buff_ready = "true" and flow.enable_outbound != "disable"</Condition>
                <Name>SMR-modelresponse</Name>
            </Step>
        </Response>
    </EventFlow>
    <HTTPTargetConnection>
        <Authentication>
            <GoogleAccessToken>
                <Scopes>
                    <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
                </Scopes>
            </GoogleAccessToken>
        </Authentication>
        <Properties>
            <Property name="target.copy.pathsuffix">false</Property>
            <!-- Client query parameters are never forwarded to Gemini (the URL below carries its own ?alt=sse). -->
            <Property name="target.copy.queryparams">false</Property>
            <Property name="connect.timeout.millis">30000</Property>
            <Property name="io.timeout.millis">60000</Property>
        </Properties>
        <URL>https://aiplatform.googleapis.com/v1/projects/YOUR_GCP_PROJECT_ID/locations/global/publishers/google/models/gemini-3.5-flash-lite:streamGenerateContent?alt=sse</URL>
    </HTTPTargetConnection>
</TargetEndpoint>
